{
  "name": "fitsquad",
  "version": "0.1.0",
  "private": true,
  "description": "瘦身战队 · 微信小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "taro build --type weapp --watch",
    "build:cloud": "node scripts/build-cloud.mjs",
    "build:h5": "taro build --type h5",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "7.29.10",
    "@tarojs/components": "4.3.1",
    "@tarojs/helper": "4.3.1",
    "@tarojs/plugin-framework-react": "4.3.1",
    "@tarojs/plugin-platform-weapp": "4.3.1",
    "@tarojs/react": "4.3.1",
    "@tarojs/runtime": "4.3.1",
    "@tarojs/shared": "4.3.1",
    "@tarojs/taro": "4.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@tarojs/cli": "4.3.1",
    "@tarojs/components-react": "4.3.1",
    "@tarojs/plugin-platform-h5": "4.3.1",
    "@tarojs/router": "4.3.1",
    "@tarojs/taro-h5": "4.3.1",
    "@tarojs/webpack5-runner": "4.3.1",
    "@types/react": "18.3.31",
    "babel-preset-taro": "4.3.1",
    "esbuild": "0.28.2",
    "miniprogram-api-typings": "5.2.3",
    "postcss": "8.5.31",
    "sass": "1.106.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webpack": "5.91.0"
  }
}
