{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@core/*": ["../core/*"],
      "@data/*": ["../data/*"]
    }
  },
  "include": ["./*/src/**/*.ts", "./**/__tests__/**/*.ts", "../core/**/*.ts"]
}
